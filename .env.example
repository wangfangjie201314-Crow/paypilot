# --- PayPal sandbox (REQUIRED for checkout; free at https://developer.paypal.com/) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- LLM (optional; any OpenAI-compatible API: OpenAI, DeepSeek, Kimi, OpenRouter, Ollama...) ---
# Leave LLM_API_KEY empty (or set DEMO_MODE=true) to run the built-in deterministic
# demo brain, which drives the same agent tool-loop with zero keys.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DEMO_MODE=false

# --- App ---
PORT=5000
BASE_URL=http://localhost:5000
DB_PATH=paypilot.db
